{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": ["main"],
  "labels": ["dependencies"],
  "argocd": {
    "managerFilePatterns": ["/^apps/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track dispatcharr image tag in workload manifests",
      "managerFilePatterns": ["/^workloads/.+\\.yaml$/"],
      "matchStrings": ["image: ghcr\\.io/dispatcharr/dispatcharr:(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "dispatcharr/dispatcharr",
      "registryUrlTemplate": "https://ghcr.io",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track custom ARC runner image digests",
      "managerFilePatterns": ["/^values/rapture-(?:apogee|matchexec|tonysofwestreading|slamanna-com|slamanna-food)\\.yaml$/"],
      "matchStrings": ["image: \\\"ghcr\\.io/(?<depName>slamanna212/runnerimages/[^:\\\"@]+):(?<currentValue>[^\\s\\\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\\""],
      "registryUrlTemplate": "https://ghcr.io",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Only track stable semver releases for dispatcharr, and prioritize it so it isn't perpetually rate-limited out by the backlog of other pending PRs",
      "matchPackageNames": ["dispatcharr/dispatcharr"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "ignoreUnstable": true,
      "prPriority": 5
    },
    {
      "description": "Group all monitoring stack updates together",
      "matchPackageNames": ["kube-prometheus-stack", "loki", "promtail"],
      "groupName": "monitoring stack"
    },
    {
      "description": "Group all GitHub Actions runner updates together",
      "matchPackageNames": ["gha-runner-scale-set", "gha-runner-scale-set-controller"],
      "groupName": "arc runners"
    },
    {
      "description": "Pin and group custom ARC runner image digests",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "slamanna212/runnerimages/apogee",
        "slamanna212/runnerimages/matchexec",
        "slamanna212/runnerimages/tonysofwestreading",
        "slamanna212/runnerimages/slamanna-com",
        "slamanna212/runnerimages/slamanna-food"
      ],
      "groupName": "custom arc runner images",
      "pinDigests": true
    }
  ]
}
